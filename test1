    /* ===================== CAMERA SCANNER ===================== */
    function openLiveCameraScanner() {
        $('camera-modal').classList.remove('hidden');
        qrScanHandled = false;
        setTimeout(() => {
            const reader = new Html5Qrcode('qr-reader');
            window.activeQrReader = reader;
            reader.start(
                { facingMode: 'environment' },
                { fps: 10, qrbox: { width: 220, height: 220 } },
                (decodedText) => {
                    if (qrScanHandled) return;       // callback ยิงซ้ำหลายครั้งก่อนกล้องหยุด
                    qrScanHandled = true;
                    showToast(`สแกนพบ: ${decodedText}`, 'success');
                    $('global-search').value = decodedText;
                    runSearch(decodedText);
                    closeLiveCameraScanner();
                },
                () => { /* ignore per-frame decode errors */ }
            ).catch(() => {
                showToast('ไม่สามารถเปิดกล้องได้ หรือเบราว์เซอร์ไม่รองรับ', 'error');
            });
        }, 300);
    }

    function closeLiveCameraScanner() {
        const hide = () => $('camera-modal').classList.add('hidden');
        const reader = window.activeQrReader;
        window.activeQrReader = null;
        if (!reader) { hide(); return; }
        reader.stop().then(() => reader.clear()).catch(() => { }).finally(hide);
    }

    /* ===================== CSV IMPORT / EXPORT ===================== */
    function parseCSV(text) {
        text = text.replace(/^\uFEFF/, '');
        const rows = [];
        let row = [], field = '', inQuotes = false;
        const pushRow = () => { row.push(field); field = ''; if (row.some(x => x.trim() !== '')) rows.push(row); row = []; };
        for (let i = 0; i < text.length; i++) {
            const c = text[i];
            if (inQuotes) {
                if (c === '"') { if (text[i + 1] === '"') { field += '"'; i++; } else inQuotes = false; }
                else field += c;
            } else if (c === '"') inQuotes = true;
            else if (c === ',') { row.push(field); field = ''; }
            else if (c === '\n' || c === '\r') { if (c === '\r' && text[i + 1] === '\n') i++; pushRow(); }
            else field += c;
        }
        if (field !== '' || row.length) pushRow();
        return rows;
    }

    function resolveZoneKey(value) {
        const v = String(value || '').trim().toLowerCase();
        if (!v) return null;
        const keys = Object.keys(defaultZoneNames);
        return keys.find(k => k.toLowerCase() === v) || keys.find(k => zoneLabel(k).toLowerCase() === v) || null;
    }

    function openDataToolsModal() {
        $('api-url-input').value = cfg.url;
        $('api-token-input').value = cfg.token;
        $('api-status-text').textContent = state.sync.status === 'error' ? `สถานะล่าสุด: ${state.sync.message}` : '';
        $('data-tools-modal').classList.remove('hidden');
    }

    function handleCSVUpload(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
            try { importInventoryCSV(String(e.target.result)); }
            catch (err) { showToast('นำเข้าไม่สำเร็จ: ' + err.message, 'error'); }
            event.target.value = '';
        };
        reader.readAsText(file, 'UTF-8');
    }

    function importInventoryCSV(text) {
        const rows = parseCSV(text);
        if (rows.length < 1) throw new Error('ไฟล์ไม่มีข้อมูล');

        const header = rows[0].map(h => h.trim().toLowerCase());
        const hasHeader = header.includes('code') || header.includes('name');
        const order = ['code', 'qr', 'name', 'date', 'countdate', 'qty', 'zone'];
        const idx = {};
        order.forEach((k, i) => { idx[k] = hasHeader ? header.indexOf(k) : i; });
        if (idx.code < 0 || idx.name < 0) throw new Error('ไม่พบคอลัมน์ code และ name');
        const cell = (r, k) => (idx[k] >= 0 && r[idx[k]] !== undefined ? String(r[idx[k]]).trim() : '');

        const byQr = new Map(state.inventory.filter(i => i.qr).map(i => [i.qr, i]));
        const out = new Map();
        let created = 0, updated = 0, skipped = 0, badZone = 0;

        rows.slice(hasHeader ? 1 : 0).forEach((r, n) => {
            const code = cell(r, 'code'), name = cell(r, 'name');
            if (!code || !name) { skipped++; return; }
            const qr = cell(r, 'qr') || `QR-${Date.now().toString(36).toUpperCase().slice(-5)}${n}`;
            let zone = resolveZoneKey(cell(r, 'zone'));
            if (!zone) { zone = 'INBOUND'; if (cell(r, 'zone')) badZone++; }
            const qtyRaw = cell(r, 'qty');
            const qty = qtyRaw === '' || !Number.isFinite(Number(qtyRaw)) ? 1 : Math.max(0, Math.floor(Number(qtyRaw)));

            const prev = out.get(qr) || byQr.get(qr);
            const item = {
                id: prev ? prev.id : uid('csv'),
                code, qr, name, qty, zone,
                date: cell(r, 'date') || (prev ? prev.date : todayStr()),
                countDate: cell(r, 'countdate') || (prev ? prev.countDate : todayStr())
            };
            if (prev && !out.has(qr)) updated++; else if (!prev) created++;
            out.set(qr, item);
        });

        if (!out.size) throw new Error('ไม่พบแถวที่ใช้งานได้ (ต้องมี code และ name)');
        upsertInventoryMany([...out.values()]);
        addAuditLog(`นำเข้า CSV ${out.size} รายการ (ใหม่ ${created} / อัปเดต ${updated} / ข้าม ${skipped})`);
        showToast(`นำเข้า ${out.size} รายการ (ใหม่ ${created}, อัปเดต ${updated}${skipped ? ', ข้าม ' + skipped : ''}${badZone ? ', โซนไม่รู้จัก ' + badZone + ' → INBOUND' : ''})`, 'success');
        closeModal('data-tools-modal');
    }

    const csvCell = (v) => `"${String(v ?? '').replace(/"/g, '""')}"`;

    function exportStockToCSV() {
        let csv = 'code,qr,name,date,countDate,qty,zone\n';
        state.inventory.forEach(i => { csv += [i.code, i.qr, i.name, i.date, i.countDate, i.qty, i.zone].map(csvCell).join(',') + '\n'; });
        downloadCSVFile(csv, `warehouse_stock_${todayStr()}.csv`);
    }

    function exportPrintingToCSV() {
        let csv = 'job,item,qtyFull,unitFull,qtyFrac,unitFrac,order,status,zone,date\n';
        state.printing.forEach(p => { csv += [p.job, p.item, p.qtyFull, p.unitFull, p.qtyFrac, p.unitFrac, p.order, p.status, p.zone, p.date].map(csvCell).join(',') + '\n'; });
        downloadCSVFile(csv, `printing_stock_${todayStr()}.csv`);
    }

    function downloadCSVFile(csvContent, fileName) {
        const blob = new Blob(['\ufeff' + csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = fileName;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        showToast('ส่งออกไฟล์ CSV สำเร็จ!', 'success');
    }

    /* ===================== API SETTINGS ===================== */
    async function saveApiSettings() {
        const url = $('api-url-input').value.trim();
        const token = $('api-token-input').value.trim();
        if (!/^https:\/\/script\.google\.com\/.+\/exec$/.test(url)) {
            showToast('URL ต้องเป็นลิงก์ Web app ของ Apps Script ที่ลงท้ายด้วย /exec', 'error');
            return;
        }
        store.set(LS.url, url);
        store.set(LS.token, token);
        $('api-status-text').textContent = 'กำลังทดสอบการเชื่อมต่อ…';
        const r = await pullFromCloud();
        if (r.ok) {
            $('api-status-text').textContent = `เชื่อมต่อสำเร็จ — Stock ${state.inventory.length}, Printing ${state.printing.length}, Logs ${state.logs.length}`;
            showToast('เชื่อมต่อ API สำเร็จ', 'success');
        } else {
            $('api-status-text').textContent = `เชื่อมต่อไม่สำเร็จ: ${r.error}`;
            showToast('เชื่อมต่อไม่สำเร็จ: ' + r.error, 'error');
        }
    }

    function resetApiSettings() {
        store.remove(LS.url);
        store.remove(LS.token);
        $('api-url-input').value = cfg.url;
        $('api-token-input').value = '';
        $('api-status-text').textContent = 'กลับไปใช้ค่าเริ่มต้นในโค้ดแล้ว';
        renderSyncBadge();
    }

    /* ===================== INIT ===================== */
    function init() {
        bindStaticEvents();
        loadCache();
        migrateLegacyZoneNames();
        renderAll();
        renderSyncBadge();

        pullFromCloud();
        if (state.queue.length) scheduleFlush(1000);

        setInterval(() => { if (!document.hidden && navigator.onLine) pullFromCloud(); }, POLL_INTERVAL_MS);
        document.addEventListener('visibilitychange', () => { if (!document.hidden) pullFromCloud(); });
        window.addEventListener('online', () => { renderSyncBadge(); pullFromCloud(); });
        window.addEventListener('offline', renderSyncBadge);
    }

    window.addEventListener('load', init);
    </script>
