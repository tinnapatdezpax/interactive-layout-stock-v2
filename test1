    function bindStaticEvents() {
        document.querySelectorAll('.zone').forEach(el => el.addEventListener('click', () => openZone(el.getAttribute('data-zone'))));
        $('global-search').addEventListener('input', (e) => {
            clearTimeout(searchTimer);
            const v = e.target.value;
            searchTimer = setTimeout(() => runSearch(v), 150);
        });
        $('count-input').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); processScan(); } });
        document.addEventListener('click', delegatedClick);
    }

