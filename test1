<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Interactive WMS - คลังสินค้า</title>
  
  <!-- Tailwind CSS สำหรับจัดสไตล์ยึดมือถือเป็นหลัก -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome สำหรับไอคอน -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- SweetAlert2 สำหรับ Pop-up แจ้งเตือน -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <!-- HTML5-QRCode สำหรับกล้องแสกน QR -->
  <script src="https://unpkg.com/html5-qrcode"></script>

  <style>
    body { font-family: 'Prompt', sans-serif; background-color: #f3f4f6; pb-20; }
    .nav-btn.active { color: #2563eb; font-weight: bold; }
    .zone-box { transition: all 0.2s; cursor: pointer; }
    .zone-box:active { transform: scale(0.95); }
  </style>
</head>
<body class="bg-gray-100 min-h-screen pb-24 text-gray-800">

  <!-- ==================== 1. TOP BAR SEARCH (มีทุกหน้า) ==================== -->
  <header class="sticky top-0 z-40 bg-blue-600 text-white p-3 shadow-md flex items-center gap-2">
    <div class="relative flex-1">
      <input type="text" id="globalSearchInput" oninput="handleGlobalSearch()" placeholder="ค้นหา ชื่อ/รหัส/QR Code..." 
             class="w-full pl-9 pr-3 py-2 rounded-lg text-gray-800 text-sm focus:outline-none shadow-inner">
      <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-gray-400"></i>
    </div>
    <button onclick="openCameraScanner()" class="bg-blue-800 hover:bg-blue-900 px-3 py-2 rounded-lg text-sm flex items-center gap-1 shadow">
      <i class="fa-solid fa-qrcode text-lg"></i>
      <span class="text-xs hidden sm:inline">สแกน</span>
    </button>
  </header>

  <!-- ==================== 2. MAIN CONTENT CONTAINERS ==================== -->
  <main class="p-3 max-w-lg mx-auto">

    <!-- PAGE 1: LAYOUT 2D -->
    <section id="page-layout" class="page-content">
      <div class="flex justify-between items-center mb-3">
        <h2 class="font-bold text-lg text-gray-700"><i class="fa-solid fa-map"></i> แผนผังคลังสินค้า (2D Layout)</h2>
        <button id="stockCountToggleBtn" onclick="toggleStockCountMode()" class="bg-yellow-500 text-white text-xs px-3 py-1.5 rounded-full font-semibold shadow">
          <i class="fa-solid fa-clipboard-check"></i> โหมดนับ Stock
        </button>
      </div>

      <!-- แถบเตือนเมื่ออยู่ในโหมดนับสต็อก -->
      <div id="stockCountBanner" class="hidden mb-3 p-2 bg-yellow-100 border border-yellow-400 text-yellow-800 text-xs rounded-lg flex items-center justify-between">
        <span><i class="fa-solid fa-circle-info"></i> กำลังอยู่ใน<b>โหมดนับสต็อก</b>: เลือกโซนเพื่อเริ่มยิง QR</span>
      </div>

      <!-- 2D Interactive Warehouse Layout Grid -->
      <div class="bg-white p-4 rounded-xl shadow border border-gray-200">
        <p class="text-xs text-gray-400 mb-2 text-center">กดเลือกโซนเพื่อดูสินค้าหรือเริ่มนับสต็อก</p>
        <div class="grid grid-cols-3 gap-3">
          <div onclick="clickZone('Zone A')" class="zone-box bg-blue-100 border-2 border-blue-400 p-4 rounded-lg text-center shadow-sm">
            <span class="block font-bold text-blue-800 text-sm">Zone A</span>
            <span class="text-[10px] text-gray-500" id="count-Zone A">0 รายการ</span>
          </div>
          <div onclick="clickZone('Zone B')" class="zone-box bg-green-100 border-2 border-green-400 p-4 rounded-lg text-center shadow-sm">
            <span class="block font-bold text-green-800 text-sm">Zone B</span>
            <span class="text-[10px] text-gray-500" id="count-Zone B">0 รายการ</span>
          </div>
          <div onclick="clickZone('Zone C')" class="zone-box bg-purple-100 border-2 border-purple-400 p-4 rounded-lg text-center shadow-sm">
            <span class="block font-bold text-purple-800 text-sm">Zone C</span>
            <span class="text-[10px] text-gray-500" id="count-Zone C">0 รายการ</span>
          </div>
          <div onclick="clickZone('Zone D')" class="zone-box bg-amber-100 border-2 border-amber-400 p-4 rounded-lg text-center shadow-sm">
            <span class="block font-bold text-amber-800 text-sm">Zone D</span>
            <span class="text-[10px] text-gray-500" id="count-Zone D">0 รายการ</span>
          </div>
          <div onclick="clickZone('Zone E')" class="zone-box bg-rose-100 border-2 border-rose-400 p-4 rounded-lg text-center shadow-sm">
            <span class="block font-bold text-rose-800 text-sm">Zone E</span>
            <span class="text-[10px] text-gray-500" id="count-Zone E">0 รายการ</span>
          </div>
          <div onclick="clickZone('Zone F')" class="zone-box bg-teal-100 border-2 border-teal-400 p-4 rounded-lg text-center shadow-sm">
            <span class="block font-bold text-teal-800 text-sm">Zone F</span>
            <span class="text-[10px] text-gray-500" id="count-Zone F">0 รายการ</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PAGE 2: SEARCH -->
    <section id="page-search" class="page-content hidden">
      <h2 class="font-bold text-lg text-gray-700 mb-3"><i class="fa-solid fa-magnifying-glass"></i> ค้นหาสินค้าแบบละเอียด</h2>
      <div class="bg-white p-4 rounded-xl shadow mb-4 space-y-3">
        <input type="text" id="searchInputDetail" placeholder="พิมพ์ชื่อสินค้า / รหัสสินค้า / QR Code" class="w-full border p-2 rounded text-sm">
        <button onclick="executeDetailSearch()" class="w-full bg-blue-600 text-white py-2 rounded text-sm font-semibold shadow">ค้นหา</button>
      </div>
      <div id="searchResults" class="space-y-2"></div>
    </section>

    <!-- PAGE 3: ALL PRODUCTS (TABLE) -->
    <section id="page-all" class="page-content hidden">
      <h2 class="font-bold text-lg text-gray-700 mb-3"><i class="fa-solid fa-boxes-stacked"></i> รายการสินค้าทั้งหมด (19 building)</h2>
      <div class="bg-white rounded-xl shadow overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-gray-50 border-b text-gray-600">
            <tr>
              <th class="p-2">สินค้า</th>
              <th class="p-2">QR Code</th>
              <th class="p-2">จำนวน</th>
            </tr>
          </thead>
          <tbody id="allProductsTableBody" class="divide-y">
            <!-- ข้อมูลดึงจาก Google Sheet จะมาขึ้นที่นี่ -->
          </tbody>
        </table>
      </div>
    </section>

    <!-- PAGE 4: PRINTING & CUSTOMIZE -->
    <section id="page-printing" class="page-content hidden">
      <div class="flex justify-between items-center mb-3">
        <h2 class="font-bold text-lg text-gray-700"><i class="fa-solid fa-print"></i> งานพิมพ์ & Customize</h2>
        <button onclick="openAddPrintingModal()" class="bg-green-600 text-white text-xs px-3 py-1.5 rounded-full font-semibold shadow">
          <i class="fa-solid fa-plus"></i> เพิ่ม Stock งานพิมพ์
        </button>
      </div>
      <div id="printingCardsContainer" class="space-y-3">
        <!-- Cards จะแสดงที่นี่ -->
      </div>
    </section>

  </main>

  <!-- ==================== 3. MODALS ==================== -->

  <!-- Modal: แสกน QR Code ด้วยกล้อง -->
  <div id="scannerModal" class="fixed inset-0 bg-black/70 z-50 hidden flex flex-col justify-center items-center p-4">
    <div class="bg-white p-4 rounded-xl w-full max-w-sm text-center">
      <h3 class="font-bold mb-2">สแกน QR Code</h3>
      <div id="reader" class="w-full h-64 bg-gray-200 rounded"></div>
      <button onclick="closeCameraScanner()" class="mt-4 bg-gray-500 text-white px-4 py-2 rounded-lg text-sm w-full">ปิดกล้อง</button>
    </div>
  </div>

  <!-- Modal: ฟอร์มเพิ่มงานพิมพ์ -->
  <div id="addPrintingModal" class="fixed inset-0 bg-black/50 z-50 hidden overflow-y-auto p-4">
    <div class="bg-white rounded-xl p-4 max-w-md mx-auto my-6 space-y-3 shadow-lg">
      <div class="flex justify-between border-b pb-2">
        <h3 class="font-bold text-gray-700">เพิ่ม Stock งานพิมพ์</h3>
        <button onclick="closeAddPrintingModal()" class="text-gray-400 font-bold">&times;</button>
      </div>
      <form id="addPrintingForm" onsubmit="savePrintingData(event)" class="space-y-2 text-xs">
        <div><label class="font-semibold">ชื่องาน</label><input type="text" id="p_jobName" required class="w-full border p-1.5 rounded"></div>
        <div><label class="font-semibold">ชื่อสินค้า</label><input type="text" id="p_productName" required class="w-full border p-1.5 rounded"></div>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="font-semibold">จำนวน</label><input type="number" id="p_qty" required class="w-full border p-1.5 rounded"></div>
          <div>
            <label class="font-semibold">หน่วย</label>
            <select id="p_unit" class="w-full border p-1.5 rounded">
              <option>ลัง</option><option>แพ็ค</option><option>ชิ้น</option><option>ห่อ</option><option>กก.</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="font-semibold">จำนวนเศษ</label><input type="number" id="p_fractionQty" value="0" class="w-full border p-1.5 rounded"></div>
          <div>
            <label class="font-semibold">หน่วย (เศษ)</label>
            <select id="p_fractionUnit" class="w-full border p-1.5 rounded">
              <option>ชิ้น</option><option>แพ็ค</option><option>ลัง</option><option>ห่อ</option><option>กก.</option>
            </select>
          </div>
        </div>
        <div><label class="font-semibold">หมายเหตุ</label><input type="text" id="p_note" class="w-full border p-1.5 rounded"></div>
        <div><label class="font-semibold">วันที่ของเข้า</label><input type="date" id="p_inboundDate" class="w-full border p-1.5 rounded"></div>
        <div><label class="font-semibold">เลข Order</label><input type="text" id="p_orderNo" required class="w-full border p-1.5 rounded"></div>
        <div>
          <label class="font-semibold">สถานะจัดส่ง</label>
          <select id="p_status" class="w-full border p-1.5 rounded">
            <option>ยังไม่ได้ส่ง</option><option>ส่งแล้ว</option>
          </select>
        </div>
        <div>
          <label class="font-semibold">โซนจัดเก็บ</label>
          <select id="p_zone" class="w-full border p-1.5 rounded">
            <option>Zone A</option><option>Zone B</option><option>Zone C</option><option>Zone D</option><option>Zone E</option><option>Zone F</option>
          </select>
        </div>
        <div>
          <label class="font-semibold">แนบรูปภาพ (อัพได้หลายรูป)</label>
          <input type="file" id="p_images" multiple accept="image/*" class="w-full border p-1 rounded">
        </div>
        <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded font-semibold text-sm shadow mt-3">บันทึกข้อมูล</button>
      </form>
    </div>
  </div>

  <!-- ==================== 4. BOTTOM NAVIGATION BAR ==================== -->
  <nav class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 flex justify-around p-2 text-center text-xs z-30 shadow-lg">
    <button onclick="switchPage('layout')" id="nav-layout" class="nav-btn active flex-1 py-1">
      <i class="fa-solid fa-map text-lg block"></i> Layout
    </button>
    <button onclick="switchPage('search')" id="nav-search" class="nav-btn flex-1 py-1">
      <i class="fa-solid fa-magnifying-glass text-lg block"></i> Search
    </button>
    <button onclick="switchPage('all')" id="nav-all" class="nav-btn flex-1 py-1">
      <i class="fa-solid fa-boxes-stacked text-lg block"></i> สินค้าทั้งหมด
    </button>
    <button onclick="switchPage('printing')" id="nav-printing" class="nav-btn flex-1 py-1">
      <i class="fa-solid fa-print text-lg block"></i> งานพิมพ์
    </button>
  </nav>

  <!-- ==================== 5. JAVASCRIPT LOGIC ==================== -->
  <script>
    // 🔴🔴 วางลิงก์ APPS SCRIPT ของคุณตรงนี้ 🔴🔴
    const API_URL = "YOUR_APPS_SCRIPT_URL_HERE";

    let globalData = { building19: [], printing: [] };
    let isStockCountMode = false;
    let html5QrCode = null;

    // โหลดข้อมูลเมื่อเปิดหน้าเว็บ
    window.onload = function() {
      // ตั้งค่าวันที่ปัจจุบันในฟอร์ม
      document.getElementById('p_inboundDate').valueToDate = new Date();
      document.getElementById('p_inboundDate').value = new Date().toISOString().substring(0, 10);
      fetchData();
    };

    // ดึงข้อมูลจาก Google Apps Script
    function fetchData() {
      Swal.fire({ title: 'กำลังโหลดข้อมูล...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
      fetch(API_URL)
        .then(res => res.json())
        .then(data => {
          globalData = data;
          Swal.close();
          renderAll();
        })
        .catch(err => {
          Swal.fire('ข้อผิดพลาด', 'ไม่สามารถดึงข้อมูลจาก Google Sheet ได้', 'error');
        });
    }

    function renderAll() {
      renderAllProductsTable();
      renderPrintingCards();
    }

    // เปลี่ยนหน้า เมนูด้านล่าง
    function switchPage(pageName) {
      document.querySelectorAll('.page-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
      
      document.getElementById(`page-${pageName}`).classList.remove('hidden');
      document.getElementById(`nav-${pageName}`).classList.add('active');
    }

    // แสดงตารางสินค้าทั้งหมด
    function renderAllProductsTable() {
      const tbody = document.getElementById('allProductsTableBody');
      tbody.innerHTML = '';
      globalData.building19.forEach(item => {
        tbody.innerHTML += `
          <tr class="hover:bg-gray-50">
            <td class="p-2 font-medium text-gray-800">${item['Product name'] || '-'}</td>
            <td class="p-2 text-gray-500">${item['QR code'] || '-'}</td>
            <td class="p-2 font-bold text-blue-600">${item['Total product'] || 0}</td>
          </tr>
        `;
      });
    }

    // แสดงการ์ดงานพิมพ์
    function renderPrintingCards() {
      const container = document.getElementById('printingCardsContainer');
      container.innerHTML = '';
      globalData.printing.forEach(item => {
        const orderUrl = `https://admin-v2.dezpax.com/order?orderCode=${item['เลขOrder']}`;
        container.innerHTML += `
          <div class="bg-white p-3 rounded-xl shadow border border-gray-100 flex gap-3 items-center">
            <div class="w-16 h-16 bg-gray-100 rounded-lg flex items-center justify-center overflow-hidden border">
              ${item['เพิ่มรูปภาพ(1)'] ? `<img src="${item['เพิ่มรูปภาพ(1)']}" class="object-cover w-full h-full">` : '<i class="fa-solid fa-image text-gray-300 text-xl"></i>'}
            </div>
            <div class="flex-1 text-xs space-y-1">
              <div class="font-bold text-sm text-gray-800">${item['ชื่องาน']}</div>
              <div class="text-gray-600">${item['ชื่อสินค้า']}</div>
              <div class="flex gap-2 text-[10px]">
                <span class="bg-blue-50 text-blue-600 px-1.5 py-0.5 rounded">${item['โซนจัดเก็บ'] || 'ไม่ระบุโซน'}</span>
                <span class="${item['สถานะจัดส่ง'] === 'ส่งแล้ว' ? 'bg-green-50 text-green-600' : 'bg-red-50 text-red-600'} px-1.5 py-0.5 rounded">${item['สถานะจัดส่ง']}</span>
              </div>
              <a href="${orderUrl}" target="_blank" class="text-blue-500 underline text-[10px] inline-block"><i class="fa-solid fa-link"></i> ลิงก์ Order</a>
            </div>
          </div>
        `;
      });
    }

    // สลับโหมดนับสต็อก
    function toggleStockCountMode() {
      isStockCountMode = !isStockCountMode;
      const btn = document.getElementById('stockCountToggleBtn');
      const banner = document.getElementById('stockCountBanner');

      if (isStockCountMode) {
        btn.classList.replace('bg-yellow-500', 'bg-red-600');
        btn.innerHTML = '<i class="fa-solid fa-xmark"></i> ยกเลิกนับ Stock';
        banner.classList.remove('hidden');
      } else {
        btn.classList.replace('bg-red-600', 'bg-yellow-500');
        btn.innerHTML = '<i class="fa-solid fa-clipboard-check"></i> โหมดนับ Stock';
        banner.classList.add('hidden');
      }
    }

    // เมื่อกดที่ Zone ใดๆ
    function clickZone(zoneName) {
      if (isStockCountMode) {
        startStockCountingInZone(zoneName);
      } else {
        Swal.fire({
          title: `รายการใน ${zoneName}`,
          html: `<p class="text-xs text-gray-500">แสดงข้อมูลรายการสินค้าในพื้นที่นี้</p>`,
          icon: 'info'
        });
      }
    }

    // ทำงานโหมดนับสต็อกในโซน
    function startStockCountingInZone(zoneName) {
      let scannedList = [];
      
      function promptScan() {
        Swal.fire({
          title: `นับสต็อก ${zoneName}`,
          input: 'text',
          inputLabel: 'ยิง QR Code หรือกรอกรหัสลังสินค้า (กด Enter เมื่อเสร็จ)',
          inputPlaceholder: 'สแกน QR Code...',
          footer: `ยิงไปแล้ว ${scannedList.length} ลัง`,
          showCancelButton: true,
          confirmButtonText: 'บันทึกเสร็จสิ้น',
          cancelButtonText: 'ยกเลิก'
        }).then((result) => {
          if (result.isConfirmed) {
            // Confirm บันทึก
            Swal.fire({
              title: 'ยืนยันการบันทึกการนับสต็อก?',
              text: "ระบบจะอัพเดตวันที่นับสินค้าลงใน Google Sheet",
              icon: 'warning',
              showCancelButton: true,
              confirmButtonText: 'ยืนยัน'
            }).then((conf) => {
              if (conf.isConfirmed) {
                saveStockCountAPI(zoneName, scannedList);
              }
            });
          } else if (result.value) {
            const qr = result.value.trim();
            if (scannedList.includes(qr)) {
              Swal.fire('เตือน!', 'สแกน QR นี้ซ้ำแล้ว', 'warning').then(() => promptScan());
            } else {
              scannedList.push(qr);
              promptScan();
            }
          }
        });
      }
      promptScan();
    }

    function saveStockCountAPI(zone, scannedQrs) {
      Swal.fire({ title: 'กำลังบันทึก...', didOpen: () => Swal.showLoading() });
      fetch(API_URL, {
        method: 'POST',
        body: JSON.stringify({
          action: 'updateStockCount',
          zone: zone,
          scannedQrs: scannedQrs,
          countDate: new Date().toLocaleDateString('th-TH')
        })
      })
      .then(res => res.json())
      .then(res => {
        Swal.fire('สำเร็จ', 'บันทึกการนับสต็อกเรียบร้อยแล้ว', 'success');
        fetchData();
      });
    }

    // Modal เพิ่มงานพิมพ์
    function openAddPrintingModal() { document.getElementById('addPrintingModal').classList.remove('hidden'); }
    function closeAddPrintingModal() { document.getElementById('addPrintingModal').classList.add('hidden'); }

    // บันทึกฟอร์มงานพิมพ์
    function savePrintingData(e) {
      e.preventDefault();
      const orderNo = document.getElementById('p_orderNo').value;
      const data = {
        jobName: document.getElementById('p_jobName').value,
        productName: document.getElementById('p_productName').value,
        qty: document.getElementById('p_qty').value,
        unit: document.getElementById('p_unit').value,
        fractionQty: document.getElementById('p_fractionQty').value,
        fractionUnit: document.getElementById('p_fractionUnit').value,
        note: document.getElementById('p_note').value,
        inboundDate: document.getElementById('p_inboundDate').value,
        orderNo: orderNo,
        status: document.getElementById('p_status').value,
        zone: document.getElementById('p_zone').value,
        linkOrder: `https://admin-v2.dezpax.com/order?orderCode=${orderNo}`,
        images: []
      };

      Swal.fire({ title: 'กำลังบันทึกงานพิมพ์...', didOpen: () => Swal.showLoading() });
      
      fetch(API_URL, {
        method: 'POST',
        body: JSON.stringify({ action: 'addPrinting', data: data })
      })
      .then(res => res.json())
      .then(res => {
        closeAddPrintingModal();
        Swal.fire('สำเร็จ!', 'บันทึกงานพิมพ์เรียบร้อยแล้ว', 'success');
        fetchData();
      });
    }

    // เปิด/ปิด กล้องสแกน QR
    function openCameraScanner() {
      document.getElementById('scannerModal').classList.remove('hidden');
      html5QrCode = new Html5Qrcode("reader");
      html5QrCode.start(
        { facingMode: "environment" },
        { fps: 10, qrbox: { width: 200, height: 200 } },
        (decodedText) => {
          closeCameraScanner();
          document.getElementById('globalSearchInput').value = decodedText;
          handleGlobalSearch();
        }
      );
    }

    function closeCameraScanner() {
      if (html5QrCode) {
        html5QrCode.stop().then(() => {
          document.getElementById('scannerModal').classList.add('hidden');
        });
      } else {
        document.getElementById('scannerModal').classList.add('hidden');
      }
    }

    function handleGlobalSearch() {
      const q = document.getElementById('globalSearchInput').value.toLowerCase();
      if (!q) return;
      switchPage('search');
      document.getElementById('searchInputDetail').value = q;
      executeDetailSearch();
    }

    function executeDetailSearch() {
      const q = document.getElementById('searchInputDetail').value.toLowerCase();
      const container = document.getElementById('searchResults');
      container.innerHTML = '';

      const matched19 = globalData.building19.filter(i => 
        (i['Product name'] && String(i['Product name']).toLowerCase().includes(q)) ||
        (i['product code'] && String(i['product code']).toLowerCase().includes(q)) ||
        (i['QR code'] && String(i['QR code']).toLowerCase().includes(q))
      );

      if (matched19.length === 0) {
        container.innerHTML = '<p class="text-center text-xs text-gray-400 py-4">ไม่พบรายการสินค้าที่ค้นหา</p>';
        return;
      }

      matched19.forEach(item => {
        container.innerHTML += `
          <div class="bg-white p-3 rounded-lg shadow border text-xs space-y-1">
            <div class="font-bold text-blue-600">${item['Product name']}</div>
            <div>รหัสสินค้า: ${item['product code']}</div>
            <div>QR Code: ${item['QR code']}</div>
            <div>จำนวนคงเหลือ: <b class="text-green-600">${item['Total product']}</b></div>
            <div>วันที่เข้า: ${item['inbound date'] || '-'}</div>
          </div>
        `;
      });
    }
  </script>
</body>
</html>
