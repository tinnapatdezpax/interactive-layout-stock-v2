        if (qr && state.inventory.some(i => i.qr === qr && i.id !== editingInventoryId)) {
            showToast(`QR "${qr}" ซ้ำกับสินค้าอื่นในระบบ`, 'error');
            return;
        }

        const existing = editingInventoryId ? state.inventory.find(i => i.id === editingInventoryId) : null;
        const item = {
            id: existing ? existing.id : uid('inv'),
            code, name, qr, qty, zone,
            date: existing ? existing.date : todayStr(),
            countDate: existing ? existing.countDate : todayStr()
