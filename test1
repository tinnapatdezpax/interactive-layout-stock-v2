            if (existing.qty !== qty) changes.push(`จำนวน ${existing.qty}->${qty}`);
            if (existing.zone !== zone) changes.push(`โซน ${zoneLabel(existing.zone)}->${zoneLabel(zone)}`);
            addAuditLog(`แก้ไขสินค้า ${name} (${code})${changes.length ? ': ' + changes.join(', ') : ''}`);
        } else {
            addAuditLog(`เพิ่มสินค้าใหม่ ${name} (${code}) จำนวน ${qty} ลัง ในโซน ${zoneLabel(zone)}`);
