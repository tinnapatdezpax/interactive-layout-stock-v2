        container.innerHTML = results.slice(0, 200).map(item => `
            <div class="glass-panel p-3 rounded-xl border border-slate-800 flex justify-between items-center cursor-pointer hover:border-blue-500/50 transition" data-act="product" data-sku="${esc(item.code)}">
