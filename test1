    /* ===================== EVENT WIRING ===================== */
    function delegatedClick(e) {
        const el = e.target.closest('[data-act]');
        if (!el) return;
        const d = el.dataset;
        switch (d.act) {
            case 'product': openProductDetail(d.sku); break;
            case 'edit-item': openEditInventoryModal(d.id); break;
            case 'delete-item': deleteInventoryItem(d.id); break;
