    function computeCountSummary() {
        const matched = [], moved = [], unknown = [];
        scannedQRsInSession.forEach(qr => {
            const it = state.inventory.find(i => i.qr === qr);
            if (!it) unknown.push(qr);
            else if (it.zone === currentActiveZone) matched.push(it);
            else moved.push(it);
        });
        const missing = state.inventory.filter(i => i.zone === currentActiveZone && !scannedQRsInSession.includes(i.qr));
        return { matched, moved, unknown, missing };
    }

    async function saveStockCount() {
        if (!scannedQRsInSession.length) { showToast('ยังไม่มีรายการสแกนในรอบนี้', 'error'); return; }

        const s = computeCountSummary();
        const zoneName = zoneLabel(currentActiveZone);
        const lines = [`โซน ${zoneName}: สแกน ${scannedQRsInSession.length} รายการ`, `• ตรงกับระบบ ${s.matched.length}`];
        if (s.moved.length) lines.push(`• อยู่ผิดโซน (จะย้ายมาโซนนี้) ${s.moved.length}`);
        if (s.unknown.length) lines.push(`• ไม่พบในระบบ (บันทึกใน Log เท่านั้น) ${s.unknown.length}`);
        if (s.missing.length) lines.push(`• อยู่ในระบบแต่ไม่ถูกสแกน ${s.missing.length}`);

        const confirmed = await showCustomDialog('ยืนยันการบันทึกสต๊อก', lines.join('\n'), true);
        if (!confirmed) return;

        const today = todayStr();
        const updates = [
            ...s.matched.map(i => ({ ...i, countDate: today })),
            ...s.moved.map(i => ({ ...i, zone: currentActiveZone, countDate: today }))
        ];
        if (updates.length) upsertInventoryMany(updates);

        addAuditLog(`นับสต๊อกโซน ${zoneName}: สแกน ${scannedQRsInSession.length} | ตรง ${s.matched.length} | ย้ายเข้า ${s.moved.length} | ไม่พบ ${s.unknown.length} | ขาด ${s.missing.length}`);
        if (s.moved.length) addAuditLog(`ย้ายเข้าโซน ${zoneName} จากการนับ: ${preview(s.moved.map(i => i.qr))}`);
        if (s.unknown.length) addAuditLog(`QR ที่ไม่พบในระบบ (โซน ${zoneName}): ${preview(s.unknown)}`);
        if (s.missing.length) addAuditLog(`QR ที่ไม่ถูกสแกน (โซน ${zoneName}): ${preview(s.missing.map(i => i.qr))}`);

        showToast('บันทึกสต๊อกสำเร็จและอัปเดตระบบแล้ว!', 'success');
        closeStockCount();
    }

