    function migrateLegacyZoneNames() {
        const legacy = store.getJSON(LS.legacyZones, null);
        if (!legacy) return;
        const ops = [];
        Object.keys(legacy).forEach(k => {
            if (defaultZoneNames[k] !== undefined && legacy[k] && legacy[k] !== defaultZoneNames[k] && state.zoneNames[k] === defaultZoneNames[k]) {
                state.zoneNames[k] = legacy[k];
                ops.push({ op: 'upsert', sheet: 'zones', data: { id: k, name: legacy[k] } });
            }
        });
        store.remove(LS.legacyZones);
        if (ops.length) { enqueue(...ops); mutated(); }
    }

