<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Warehouse Digital Twin - Phase 2 (Apps Script API)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- HTML5 QR Code Scanner (pinned version) -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <!-- Prompt Font Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-main: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.7);
        }
        body {
            font-family: 'Prompt', sans-serif;
            background-color: #090d16;
            color: #f1f5f9;
            height: 100vh;
            height: 100dvh;
        }
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }

        .fade-in { animation: fadeIn 0.25s ease-out; }
        .slide-up { animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
        .press { transition: transform .12s ease; }
        .press:active { transform: scale(0.98); }
        @keyframes fadeIn { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

        /* Modern SVG Zone Map Styles */
        svg { width: 100%; height: auto; touch-action: pan-y; }
        .zone {
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            stroke-width: 1.5;
            rx: 6px;
            ry: 6px;
        }
        .zone:hover, .zone:active {
            filter: drop-shadow(0px 0px 8px rgba(59, 130, 246, 0.8));
            opacity: 0.85;
            stroke: #60a5fa !important;
            stroke-width: 2.5;
        }

        /* Glassmorphism Styling */
        .glass-panel {
            background: rgba(30, 41, 59, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-nav {
            background: rgba(15, 23, 42, 0.90);
            backdrop-filter: blur(16px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }
        #qr-reader video { object-fit: cover !important; border-radius: 12px; }
    </style>
</head>
<body class="flex flex-col overflow-hidden text-slate-100">

    <!-- Toast Notification Overlay (above every modal) -->
    <div id="toast-container" class="fixed top-4 right-4 left-4 sm:left-auto z-[70] flex flex-col gap-2 pointer-events-none"></div>

    <!-- Custom Dialog / Alert Modal (above count-modal) -->
    <div id="dialog-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden z-[60] flex items-center justify-center p-4">
        <div class="glass-panel bg-slate-900 border border-slate-700 w-full max-w-sm rounded-2xl p-5 shadow-2xl slide-up text-center">
            <div id="dialog-icon" class="w-12 h-12 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center text-xl mx-auto mb-3">
                <i class="fa-solid fa-circle-info"></i>
            </div>
            <h3 id="dialog-title" class="font-bold text-base text-slate-100 mb-1">การแจ้งเตือน</h3>
            <p id="dialog-message" class="text-xs text-slate-300 mb-5 leading-relaxed whitespace-pre-line text-left"></p>
            <div id="dialog-actions" class="flex gap-2 justify-center">
                <button id="dialog-btn-confirm" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-medium py-2.5 rounded-xl text-xs transition">ตกลง</button>
                <button id="dialog-btn-cancel" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium py-2.5 rounded-xl text-xs border border-slate-700 hidden">ยกเลิก</button>
            </div>
        </div>
    </div>

    <!-- Top Header Bar -->
    <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 p-4 shadow-lg z-20 flex-shrink-0">
        <div class="flex justify-between items-center mb-3">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center text-white shadow-lg shadow-blue-500/30">
                    <i class="fa-solid fa-cubes text-lg"></i>
                </div>
                <div>
                    <h1 class="text-base font-bold tracking-wide bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">WAREHOUSE TWIN</h1>
                    <p class="text-[10px] text-cyan-400 font-medium tracking-wider">REALTIME INVENTORY SYSTEM</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <!-- กดเพื่อซิงค์ทันที -->
                <button id="sync-status-badge" onclick="syncNow()" title="กดเพื่อซิงค์ข้อมูลทันที"
                        class="text-[10px] bg-slate-500/10 text-slate-300 border border-slate-500/30 px-2.5 py-1 rounded-full flex items-center gap-1.5 font-medium">
                    <span class="w-2 h-2 rounded-full bg-slate-400"></span> Connecting…
                </button>
                <button onclick="openDataToolsModal()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-2.5 py-1.5 rounded-lg border border-slate-700 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-gear text-emerald-400"></i> ตั้งค่า / ข้อมูล
                </button>
            </div>
        </div>

        <!-- Global Search Bar -->
        <div class="relative flex gap-2">
            <div class="relative flex-grow">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-sm"></i>
                <input type="text" id="global-search" placeholder="ค้นหา SKU, ชื่อสินค้า, QR Code, โซน..."
                       class="w-full pl-10 pr-4 py-2.5 bg-slate-800/80 border border-slate-700 rounded-xl text-slate-100 placeholder-slate-400 text-sm focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition">
            </div>
            <button onclick="openLiveCameraScanner()" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white px-4 rounded-xl flex items-center justify-center transition shadow-lg shadow-blue-600/30" title="สแกนด้วยกล้อง">
                <i class="fa-solid fa-camera text-base"></i>
            </button>
        </div>
    </header>

    <main class="flex-grow overflow-y-auto relative pb-24" id="main-content">

        <!-- ================= VIEW 1: LAYOUT (ผังคลัง 2D) ================= -->
        <section id="view-layout" class="p-4 fade-in">
            <div class="glass-panel rounded-2xl p-3 mb-4 shadow-xl border border-slate-800">
                <div class="flex justify-between items-center mb-3 px-1">
                    <p class="text-xs text-slate-400"><i class="fa-solid fa-hand-pointer text-blue-400 mr-1"></i> แตะที่โซนในผังเพื่อดูและจัดการสต๊อก</p>
                    <span class="text-[10px] text-slate-400 bg-slate-800 px-2 py-0.5 rounded-md border border-slate-700">Digital Twin Map</span>
                </div>

                <!-- SVG Interactive Warehouse Layout -->
                <div class="w-full border border-slate-800 bg-slate-950/80 relative overflow-hidden rounded-xl shadow-inner p-2">
                    <svg viewBox="0 0 400 760" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="grad-green" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#10B981" stop-opacity="0.6"/>
                                <stop offset="100%" stop-color="#059669" stop-opacity="0.8"/>
                            </linearGradient>
                            <linearGradient id="grad-red" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#EF4444" stop-opacity="0.6"/>
                                <stop offset="100%" stop-color="#DC2626" stop-opacity="0.8"/>
                            </linearGradient>
                            <linearGradient id="grad-blue" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.6"/>
                                <stop offset="100%" stop-color="#2563EB" stop-opacity="0.8"/>
                            </linearGradient>
                            <linearGradient id="grad-yellow" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.6"/>
                                <stop offset="100%" stop-color="#D97706" stop-opacity="0.8"/>
                            </linearGradient>
                            <linearGradient id="grad-cyan" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.6"/>
                                <stop offset="100%" stop-color="#0891B2" stop-opacity="0.8"/>
                            </linearGradient>
                            <linearGradient id="grad-orange" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#F97316" stop-opacity="0.6"/>
                                <stop offset="100%" stop-color="#EA580C" stop-opacity="0.8"/>
                            </linearGradient>
                        </defs>

                        <!-- Outer Warehouse Border -->
                        <rect x="10" y="10" width="380" height="740" fill="none" stroke="#334155" stroke-width="3" stroke-dasharray="6,6" rx="12"/>

                        <!-- ZONES (หมายเหตุ: <text> ต้องอยู่ถัดจาก <rect class="zone"> เสมอ เพราะใช้เปลี่ยนชื่อโซน) -->
                        <rect class="zone" data-zone="PLASTIC/PAPER" x="20" y="20" width="170" height="110" fill="url(#grad-green)" stroke="#34D399"/>
                        <text x="105" y="75" fill="#ffffff" font-size="11" font-weight="bold" text-anchor="middle" pointer-events="none">PLASTIC / PAPER</text>

                        <rect class="zone" data-zone="BUFFER-A" x="200" y="20" width="180" height="50" fill="url(#grad-red)" stroke="#F87171"/>
                        <text x="290" y="50" fill="#ffffff" font-size="10" font-weight="bold" text-anchor="middle" pointer-events="none">BUFFER / BIG LOT A</text>

                        <rect class="zone" data-zone="PRINTING STORAGE" x="200" y="80" width="180" height="50" fill="url(#grad-blue)" stroke="#60A5FA"/>
                        <text x="290" y="110" fill="#ffffff" font-size="10" font-weight="bold" text-anchor="middle" pointer-events="none">PRINTING STORAGE</text>

                        <rect class="zone" data-zone="PENDING ZONE" x="20" y="145" width="80" height="135" fill="url(#grad-yellow)" stroke="#FBBF24"/>
                        <text x="60" y="215" fill="#ffffff" font-size="10" font-weight="bold" text-anchor="middle" pointer-events="none">PENDING</text>

                        <rect class="zone" data-zone="BUFFER-B" x="120" y="145" width="260" height="35" fill="url(#grad-red)" stroke="#F87171"/>
                        <text x="250" y="167" fill="#ffffff" font-size="10" font-weight="bold" text-anchor="middle" pointer-events="none">BUFFER / BIG LOT B</text>

                        <!-- Racks Top -->
                        <rect class="zone" data-zone="STORAGE-1" x="120" y="190" width="55" height="90" fill="url(#grad-green)" stroke="#34D399"/>
                        <text x="147" y="240" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle" pointer-events="none">ST-1</text>

                        <rect class="zone" data-zone="STORAGE-2" x="188" y="190" width="55" height="90" fill="url(#grad-green)" stroke="#34D399"/>
                        <text x="215" y="240" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle" pointer-events="none">ST-2</text>

                        <rect class="zone" data-zone="STORAGE-3" x="256" y="190" width="55" height="90" fill="url(#grad-green)" stroke="#34D399"/>
                        <text x="283" y="240" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle" pointer-events="none">ST-3</text>

                        <rect class="zone" data-zone="STORAGE-4" x="325" y="190" width="55" height="90" fill="url(#grad-green)" stroke="#34D399"/>
                        <text x="352" y="240" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle" pointer-events="none">ST-4</text>

                        <!-- Inbound & Customize -->
                        <rect class="zone" data-zone="INBOUND" x="20" y="295" width="80" height="60" fill="url(#grad-yellow)" stroke="#FBBF24"/>
                        <text x="60" y="330" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle" pointer-events="none">INBOUND</text>

                        <rect class="zone" data-zone="CUSTOMIZE STORAGE" x="20" y="365" width="80" height="200" fill="url(#grad-cyan)" stroke="#22D3EE"/>
                        <text x="60" y="465" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle" pointer-events="none">CUSTOMIZE</text>

                        <!-- Racks Bottom -->
                        <rect class="zone" data-zone="STORAGE-5" x="120" y="295" width="55" height="270" fill="url(#grad-green)" stroke="#34D399"/>
                        <text x="147" y="430" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle" pointer-events="none">ST-5</text>

                        <rect class="zone" data-zone="STORAGE-6" x="188" y="295" width="55" height="270" fill="url(#grad-green)" stroke="#34D399"/>
                        <text x="215" y="430" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle" pointer-events="none">ST-6</text>

                        <rect class="zone" data-zone="STORAGE-7" x="256" y="295" width="55" height="270" fill="url(#grad-green)" stroke="#34D399"/>
                        <text x="283" y="430" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle" pointer-events="none">ST-7</text>

                        <rect class="zone" data-zone="STORAGE-8" x="325" y="295" width="55" height="270" fill="url(#grad-green)" stroke="#34D399"/>
                        <text x="352" y="430" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle" pointer-events="none">ST-8</text>

                        <!-- Outbound -->
                        <rect class="zone" data-zone="OUTBOUND-A" x="20" y="580" width="360" height="60" fill="url(#grad-orange)" stroke="#FB923C"/>
                        <text x="200" y="615" fill="#ffffff" font-size="11" font-weight="bold" text-anchor="middle" pointer-events="none">OUTBOUND STAGING A</text>

                        <rect class="zone" data-zone="OUTBOUND-B" x="20" y="670" width="360" height="50" fill="url(#grad-orange)" stroke="#FB923C"/>
                        <text x="200" y="700" fill="#ffffff" font-size="11" font-weight="bold" text-anchor="middle" pointer-events="none">OUTBOUND DISPATCH B</text>
                    </svg>
                </div>
            </div>
        </section>

        <!-- ================= VIEW 2: SEARCH RESULTS ================= -->
        <section id="view-search" class="p-4 hidden fade-in">
            <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-800">
                <h2 class="font-bold text-slate-200"><i class="fa-solid fa-list-check text-blue-400 mr-2"></i>ผลการค้นหาสินค้า</h2>
                <span id="search-count-badge" class="text-xs bg-blue-500/20 text-blue-400 px-2 py-0.5 rounded-full border border-blue-500/30">0 รายการ</span>
            </div>
            <div id="search-results-container" class="space-y-3"></div>
        </section>

        <!-- ================= VIEW 3: INVENTORY ================= -->
        <section id="view-list" class="p-4 hidden fade-in">
            <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-800">
                <h2 class="font-bold text-slate-200"><i class="fa-solid fa-boxes-stacked text-blue-400 mr-2"></i>รายการสินค้าทั้งหมด (Stock)</h2>
                <div class="flex items-center gap-2">
                    <button onclick="openAddInventoryModal()" class="bg-blue-600 hover:bg-blue-500 text-white text-xs px-2.5 py-1 rounded-lg font-medium shadow-md transition">
                        <i class="fa-solid fa-plus mr-1"></i>เพิ่มสินค้า
                    </button>
                    <span class="text-xs bg-slate-800 text-slate-300 px-2.5 py-1 rounded-full border border-slate-700" id="total-items-badge">0 รายการ</span>
                </div>
            </div>

            <div class="glass-panel rounded-2xl overflow-hidden border border-slate-800 shadow-xl">
                <div class="overflow-x-auto">
                    <table class="min-w-full text-xs text-left">
                        <thead class="bg-slate-900/90 text-slate-400 font-semibold border-b border-slate-800">
                            <tr>
                                <th class="px-4 py-3">ชื่อสินค้า / SKU</th>
                                <th class="px-4 py-3 text-center">จำนวน</th>
                                <th class="px-4 py-3">โซนจัดเก็บ</th>
                                <th class="px-4 py-3 text-right">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody id="inventory-table-body" class="divide-y divide-slate-800/60"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ================= VIEW 4: PRINTING & CUSTOMIZE ================= -->
        <section id="view-printing" class="p-4 hidden fade-in">
            <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-800">
                <div>
                    <h2 class="font-bold text-slate-200"><i class="fa-solid fa-print text-cyan-400 mr-2"></i>Printing & Customize Stock</h2>
                    <p class="text-[11px] text-slate-400">สต๊อกงานพิมพ์และสินค้าสั่งทำพิเศษ</p>
                </div>
            </div>
            <div id="printing-cards-container" class="grid grid-cols-1 gap-3"></div>

            <button onclick="openPrintingForm()" class="fixed bottom-20 right-4 w-14 h-14 bg-gradient-to-tr from-blue-600 to-cyan-500 text-white rounded-full shadow-lg shadow-cyan-500/30 flex items-center justify-center text-xl hover:scale-105 active:scale-95 transition z-10 border border-cyan-400/30">
                <i class="fa-solid fa-plus"></i>
            </button>
        </section>

        <!-- ================= VIEW 5: LOGS / AUDIT TRAIL ================= -->
        <section id="view-logs" class="p-4 hidden fade-in">
            <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-800">
                <div>
                    <h2 class="font-bold text-slate-200"><i class="fa-solid fa-clock-rotate-left text-amber-400 mr-2"></i>ประวัติการนับ & สแกน (Audit Logs)</h2>
                    <p class="text-[11px] text-slate-400">บันทึกกิจกรรมการนับสต๊อกและอัปเดตข้อมูล (แสดงล่าสุด 300 รายการ)</p>
                </div>
            </div>
            <div id="logs-container" class="space-y-2"></div>
        </section>

    </main>

    <!-- Bottom Navigation Bar -->
    <nav class="glass-nav fixed bottom-0 w-full flex justify-around py-2 z-20">
        <button onclick="switchTab('layout')" id="nav-layout" class="nav-btn flex-1 flex flex-col items-center py-1 text-blue-400 transition">
            <i class="fa-solid fa-map-location-dot text-lg mb-0.5"></i>
            <span class="text-[10px] font-medium tracking-wide">LAYOUT</span>
        </button>
        <button onclick="switchTab('list')" id="nav-list" class="nav-btn flex-1 flex flex-col items-center py-1 text-slate-400 transition hover:text-blue-400">
            <i class="fa-solid fa-boxes-stacked text-lg mb-0.5"></i>
            <span class="text-[10px] font-medium tracking-wide">STOCK</span>
        </button>
        <button onclick="switchTab('printing')" id="nav-printing" class="nav-btn flex-1 flex flex-col items-center py-1 text-slate-400 transition hover:text-blue-400">
            <i class="fa-solid fa-print text-lg mb-0.5"></i>
            <span class="text-[10px] font-medium tracking-wide">PRINTING</span>
        </button>
        <button onclick="switchTab('logs')" id="nav-logs" class="nav-btn flex-1 flex flex-col items-center py-1 text-slate-400 transition hover:text-blue-400">
            <i class="fa-solid fa-clock-rotate-left text-lg mb-0.5"></i>
            <span class="text-[10px] font-medium tracking-wide">LOGS</span>
        </button>
    </nav>


    <!-- MODAL: LIVE CAMERA SCANNER -->
    <div id="camera-modal" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md hidden z-50 flex flex-col justify-between p-4">
        <div class="flex justify-between items-center text-slate-200">
            <h3 class="font-bold text-sm flex items-center gap-2"><i class="fa-solid fa-camera text-cyan-400"></i> กล้องสแกน QR / Barcode</h3>
            <button onclick="closeLiveCameraScanner()" class="p-2 text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
        </div>

        <div class="flex-grow flex flex-col justify-center items-center my-4 overflow-hidden">
            <div id="qr-reader" class="w-full max-w-sm bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-2xl"></div>
            <p class="text-xs text-slate-400 mt-3 text-center">ส่องกล้องไปที่ QR Code หรือ Barcode บนสินค้าเพื่อค้นหาอัตโนมัติ</p>
        </div>

        <button onclick="closeLiveCameraScanner()" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 py-3 rounded-xl font-medium text-xs border border-slate-700">ปิดกล้อง</button>
    </div>

    <!-- MODAL: Settings / Import / Export -->
    <div id="data-tools-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4">
        <div class="glass-panel bg-slate-900 border border-slate-800 w-full max-w-md rounded-2xl p-5 slide-up shadow-2xl space-y-4 max-h-[92vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-bold text-sm text-emerald-400 flex items-center gap-2"><i class="fa-solid fa-gear"></i> ตั้งค่า & จัดการข้อมูล</h3>
                <button onclick="closeModal('data-tools-modal')" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <!-- API Settings -->
            <div class="bg-slate-800/50 p-3.5 rounded-xl border border-slate-700/60 space-y-2">
                <h4 class="font-semibold text-xs text-slate-200"><i class="fa-solid fa-plug text-cyan-400 mr-1.5"></i>เชื่อมต่อ Google Apps Script API</h4>
                <input type="url" id="api-url-input" class="w-full bg-slate-900 border border-slate-700 p-2 rounded-lg text-slate-100 text-[11px] font-mono" placeholder="https://script.google.com/macros/s/.../exec">
                <input type="password" id="api-token-input" class="w-full bg-slate-900 border border-slate-700 p-2 rounded-lg text-slate-100 text-[11px] font-mono" placeholder="API Token (ถ้ามี — เว้นว่างได้)" autocomplete="off">
                <div class="grid grid-cols-2 gap-2">
