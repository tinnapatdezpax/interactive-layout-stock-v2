                <button onclick="closeModal('printing-detail-modal')" class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-200 py-3 rounded-xl text-xs font-medium border border-slate-700">ปิด</button>
                <button onclick="deletePrintingFromDetail()" class="px-4 bg-rose-600/20 hover:bg-rose-600/30 text-rose-300 py-3 rounded-xl text-xs font-medium border border-rose-500/30" title="ลบงานนี้">
                    <i class="fa-solid fa-trash"></i>
                </button>
                <button onclick="editPrintingItemFromDetail()" class="flex-1 bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-3 rounded-xl text-xs font-medium shadow-lg shadow-blue-500/20 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-pen-to-square"></i> แก้ไขข้อมูล
                </button>
            </div>
        </div>
    </div>

    <script>
    /* =====================================================================
     *  Warehouse Twin — Google Apps Script API edition
     *  - Local-first: อ่าน/เขียนจาก cache ในเครื่องก่อน แล้วซิงค์ขึ้น Google Sheets
     *  - Offline queue: ถ้าส่งไม่สำเร็จจะเก็บคิวไว้และส่งซ้ำอัตโนมัติ
     *  - สัญญา API (ดู Code.gs):
     *      GET  {URL}?action=getAll[&token=..]  -> { ok, data:{ inventory[], printing[], zones[], logs[] } }
     *      POST {URL}  (Content-Type: text/plain) body = {"action":"batch","token":"..","ops":[
     *              {"op":"upsert","sheet":"inventory","data":{...}},
     *              {"op":"delete","sheet":"inventory","id":"..."} ]}
     *                                           -> { ok, result:{ applied } }
     * ===================================================================== */

    /* ===================== CONFIG ===================== */
    const DEFAULT_API_URL = 'https://script.google.com/macros/s/AKfycby52xkA6EAc6DSGHfvQK7L_JRAT8dzk5MzM1fB_DGAMTigBm3YD9IiMUXFDkYJn97e0/exec';
    const POLL_INTERVAL_MS = 30000;   // ดึงข้อมูลใหม่จาก Sheets ทุก 30 วินาที (เมื่อเปิดหน้าจออยู่)
    const RETRY_DELAY_MS = 15000;     // ส่งซ้ำเมื่อ sync ล้มเหลว
    const LOG_LIMIT = 300;
    const TABLE_RENDER_LIMIT = 500;
    const LS = { cache: 'wh_cache_v2', queue: 'wh_queue_v2', url: 'wh_api_url', token: 'wh_api_token', legacyZones: 'wh_custom_zone_names' };

    const defaultZoneNames = {
        "PLASTIC/PAPER": "PLASTIC / PAPER",
        "BUFFER-A": "BUFFER / BIG LOT A",
        "PRINTING STORAGE": "PRINTING STORAGE",
        "PENDING ZONE": "PENDING ZONE",
        "BUFFER-B": "BUFFER / BIG LOT B",
        "STORAGE-1": "ST-1", "STORAGE-2": "ST-2", "STORAGE-3": "ST-3", "STORAGE-4": "ST-4",
        "STORAGE-5": "ST-5", "STORAGE-6": "ST-6", "STORAGE-7": "ST-7", "STORAGE-8": "ST-8",
        "INBOUND": "INBOUND",
        "CUSTOMIZE STORAGE": "CUSTOMIZE",
        "OUTBOUND-A": "OUTBOUND STAGING A",
        "OUTBOUND-B": "OUTBOUND DISPATCH B"
    };

    /* ===================== HELPERS ===================== */
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const num = (v) => { const n = Number(v); return Number.isFinite(n) ? n : 0; };
    const todayStr = () => { const d = new Date(), p = n => String(n).padStart(2, '0'); return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`; };
    const uid = (prefix) => `${prefix}-${(window.crypto && crypto.randomUUID) ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(16).slice(2)}`;
    const preview = (arr, n = 10) => arr.slice(0, n).join(', ') + (arr.length > n ? ` (+${arr.length - n})` : '');

    const store = {
        get(k, fb = null) { try { const v = localStorage.getItem(k); return v === null ? fb : v; } catch (e) { return fb; } },
        set(k, v) { try { localStorage.setItem(k, v); } catch (e) { /* quota / private mode */ } },
        remove(k) { try { localStorage.removeItem(k); } catch (e) { } },
        getJSON(k, fb) { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : fb; } catch (e) { return fb; } },
        setJSON(k, v) { this.set(k, JSON.stringify(v)); }
    };

    const cfg = {
        get url() { return (store.get(LS.url) || DEFAULT_API_URL).trim(); },
        get token() { return (store.get(LS.token) || '').trim(); }
    };

    /* ===================== STATE ===================== */
    const state = {
        inventory: [],
        printing: [],
        logs: [],
        zoneNames: { ...defaultZoneNames },
        queue: [],            // คิว op ที่ยังไม่ได้ส่งขึ้น Sheets
        version: 0,           // เพิ่มทุกครั้งที่แก้ข้อมูลในเครื่อง (กัน pull เขียนทับของใหม่)
        sync: { status: 'idle', message: '', last: null }
    };

    let currentActiveZone = '';
    let scannedQRsInSession = [];
    let editingInventoryId = null;
    let editingPrintingId = null;
    let flushing = false, flushTimer = null, retryTimer = null, searchTimer = null;
    let qrScanHandled = false;

    const zoneLabel = (key) => state.zoneNames[key] || key;

    /* ===================== NORMALIZERS (ข้อมูลจาก Sheets เป็นชนิดไม่แน่นอน) ===================== */
    const normInv = (r) => ({
        id: String(r.id), code: String(r.code ?? ''), qr: String(r.qr ?? ''), name: String(r.name ?? ''),
        date: String(r.date ?? ''), countDate: String(r.countDate ?? ''), qty: num(r.qty), zone: String(r.zone || 'INBOUND')
    });
    const normPrint = (r) => ({
        id: String(r.id), job: String(r.job ?? ''), item: String(r.item ?? ''),
        qtyFull: num(r.qtyFull), unitFull: String(r.unitFull ?? ''), qtyFrac: num(r.qtyFrac), unitFrac: String(r.unitFrac ?? ''),
        order: String(r.order ?? ''), status: r.status === 'shipped' ? 'shipped' : 'pending',
        zone: String(r.zone || 'PRINTING STORAGE'), date: String(r.date ?? '')
    });
    const normLog = (r) => ({ id: String(r.id), text: String(r.text ?? ''), timestamp: String(r.timestamp ?? ''), time: num(r.time) });

    /* ===================== LOCAL CACHE ===================== */
    function saveCache() {
        store.setJSON(LS.cache, {
            inventory: state.inventory, printing: state.printing,
            logs: state.logs.slice(0, LOG_LIMIT), zoneNames: state.zoneNames, savedAt: Date.now()
        });
    }
    function loadCache() {
        const c = store.getJSON(LS.cache, null);
        if (c) {
            state.inventory = (c.inventory || []).map(normInv);
            state.printing = (c.printing || []).map(normPrint);
            state.logs = (c.logs || []).map(normLog);
            state.zoneNames = { ...defaultZoneNames, ...(c.zoneNames || {}) };
        }
        state.queue = store.getJSON(LS.queue, []);
    }
    function mutated() { state.version++; saveCache(); }

    /* ===================== API CLIENT ===================== */
    async function fetchJSON(url, options, timeoutMs) {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), timeoutMs);
        try {
            const res = await fetch(url, { ...options, signal: ctrl.signal, redirect: 'follow' });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const text = await res.text();
            let json;
            try { json = JSON.parse(text); }
            catch (e) { throw new Error('API ไม่ได้ตอบเป็น JSON — ตรวจสอบว่า Deploy เป็น Web app และตั้งสิทธิ์เป็น "Anyone"'); }
            if (!json || json.ok === false) throw new Error((json && json.error) || 'API error');
            return json;
        } catch (e) {
            if (e.name === 'AbortError') throw new Error('หมดเวลาเชื่อมต่อ API');
            throw e;
        } finally {
            clearTimeout(timer);
        }
    }

    const api = {
        getAll() {
            const u = new URL(cfg.url);
            u.searchParams.set('action', 'getAll');
            if (cfg.token) u.searchParams.set('token', cfg.token);
            return fetchJSON(u.toString(), { method: 'GET' }, 25000);
        },
        // ใช้ text/plain เพื่อเลี่ยง CORS preflight ซึ่ง Apps Script ไม่รองรับ
        batch(ops) {
            return fetchJSON(cfg.url, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify({ action: 'batch', token: cfg.token, ops })
            }, 40000);
        }
    };

    /* ===================== SYNC ENGINE ===================== */
    function setSync(status, message = '') {
        state.sync.status = status;
        state.sync.message = message;
        if (status === 'ok') state.sync.last = new Date();
        renderSyncBadge();
    }

    function renderSyncBadge() {
        const b = $('sync-status-badge');
        if (!b) return;
        const q = state.queue.length;
        const base = 'text-[10px] border px-2.5 py-1 rounded-full flex items-center gap-1.5 font-medium transition ';
        const pending = q ? ` · รอส่ง ${q}` : '';
        let cls, dot, label, title;

        if (!cfg.url) {
            cls = 'bg-amber-500/10 text-amber-400 border-amber-500/30'; dot = 'bg-amber-400'; label = 'ยังไม่ตั้งค่า API'; title = 'เปิด ตั้งค่า / ข้อมูล เพื่อใส่ URL';
        } else if (!navigator.onLine) {
            cls = 'bg-amber-500/10 text-amber-400 border-amber-500/30'; dot = 'bg-amber-400'; label = 'Offline' + pending; title = 'ออฟไลน์ — ข้อมูลจะถูกส่งเมื่อกลับมาออนไลน์';
        } else if (state.sync.status === 'syncing') {
            cls = 'bg-blue-500/10 text-blue-400 border-blue-500/30'; dot = 'bg-blue-400 animate-pulse'; label = 'Syncing…'; title = 'กำลังซิงค์';
        } else if (state.sync.status === 'error') {
            cls = 'bg-rose-500/10 text-rose-400 border-rose-500/30'; dot = 'bg-rose-400'; label = 'Sync Error' + pending; title = state.sync.message || 'ซิงค์ไม่สำเร็จ (กดเพื่อลองใหม่)';
        } else if (state.sync.status === 'ok') {
            cls = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'; dot = 'bg-emerald-400 animate-pulse'; label = 'Cloud Synced'; title = 'ซิงค์ล่าสุด ' + (state.sync.last ? state.sync.last.toLocaleTimeString('th-TH') : '-');
        } else {
            cls = 'bg-slate-500/10 text-slate-300 border-slate-500/30'; dot = 'bg-slate-400'; label = 'Connecting…'; title = 'กำลังเชื่อมต่อ';
        }
        b.className = base + cls;
        b.title = title;
        b.innerHTML = `<span class="w-2 h-2 rounded-full ${dot}"></span> ${esc(label)}`;
    }

    function persistQueue() { store.setJSON(LS.queue, state.queue); }

    function enqueue(...ops) {
        state.queue.push(...ops);
        persistQueue();
        renderSyncBadge();
        scheduleFlush(250);
    }

    function scheduleFlush(ms = 250) {
        clearTimeout(flushTimer);
        flushTimer = setTimeout(flushQueue, ms);
    }

    async function flushQueue() {
        if (flushing || state.queue.length === 0 || !cfg.url) return;
        if (!navigator.onLine) { renderSyncBadge(); return; }

        flushing = true;
        setSync('syncing');
        const sending = state.queue.slice(0, 200);
        let ok = false;
        try {
            await api.batch(sending);
            state.queue.splice(0, sending.length);
            persistQueue();
            ok = true;
            setSync('ok');
        } catch (err) {
            console.warn('[sync] flush failed:', err);
            setSync('error', err.message);
            clearTimeout(retryTimer);
            retryTimer = setTimeout(flushQueue, RETRY_DELAY_MS);
        } finally {
            flushing = false;
        }
        if (ok && state.queue.length) flushQueue();
    }

    async function pullFromCloud() {
        if (!cfg.url) { renderSyncBadge(); return { ok: false, error: 'ยังไม่ได้ตั้งค่า API URL' }; }
        if (!navigator.onLine) { renderSyncBadge(); return { ok: false, error: 'ออฟไลน์อยู่' }; }

        // มีของที่ยังไม่ได้ส่ง → ส่งก่อน ไม่งั้นข้อมูลที่ดึงมาจะเขียนทับงานล่าสุดในเครื่อง
        if (state.queue.length) {
            await flushQueue();
            if (state.queue.length) return { ok: false, error: 'ยังมีรายการรอส่งขึ้นคลาวด์ (' + state.queue.length + ')' };
        }

        const startVersion = state.version;
        setSync('syncing');
        try {
            const json = await api.getAll();
            const d = json.data || {};
            if (startVersion !== state.version) { setSync('ok'); return { ok: true, skipped: true }; } // มีการแก้ไขระหว่างรอ

            if (Array.isArray(d.inventory)) state.inventory = d.inventory.filter(r => r && r.id !== undefined && r.id !== '').map(normInv);
            if (Array.isArray(d.printing)) state.printing = d.printing.filter(r => r && r.id !== undefined && r.id !== '').map(normPrint)
                .sort((a, b) => String(b.date).localeCompare(String(a.date)));
            if (Array.isArray(d.logs)) state.logs = d.logs.filter(r => r && r.id).map(normLog).sort((a, b) => b.time - a.time).slice(0, LOG_LIMIT);
            if (Array.isArray(d.zones)) {
                const map = {};
                d.zones.forEach(z => { if (z && z.id && z.name) map[String(z.id)] = String(z.name); });
                state.zoneNames = { ...defaultZoneNames, ...map };
            }
            saveCache();
            renderAll();
            setSync('ok');
            return { ok: true };
        } catch (err) {
            console.warn('[sync] pull failed:', err);
            setSync('error', err.message);
            return { ok: false, error: err.message };
        }
    }

    async function syncNow() {
        const r = await pullFromCloud();
        if (r.ok) showToast('ซิงค์ข้อมูลเรียบร้อย', 'success');
        else showToast('ซิงค์ไม่สำเร็จ: ' + r.error, 'error');
    }

    /* ===================== DATA MUTATIONS ===================== */
    function upsertInventoryMany(items) {
        const idx = new Map(state.inventory.map((x, i) => [x.id, i]));
        items.forEach(it => {
            if (idx.has(it.id)) state.inventory[idx.get(it.id)] = it;
            else state.inventory.unshift(it);
        });
        enqueue(...items.map(data => ({ op: 'upsert', sheet: 'inventory', data })));
        mutated();
        renderInventoryViews();
    }

    function removeInventory(id) {
        state.inventory = state.inventory.filter(i => i.id !== id);
        enqueue({ op: 'delete', sheet: 'inventory', id });
        mutated();
        renderInventoryViews();
    }

    function upsertPrinting(data) {
        const i = state.printing.findIndex(p => p.id === data.id);
        if (i >= 0) state.printing[i] = data; else state.printing.unshift(data);
        enqueue({ op: 'upsert', sheet: 'printing', data });
        mutated();
        renderPrintingCards();
    }

    function removePrinting(id) {
        state.printing = state.printing.filter(p => p.id !== id);
        enqueue({ op: 'delete', sheet: 'printing', id });
        mutated();
        renderPrintingCards();
    }

    function addAuditLog(text) {
        const entry = { id: uid('log'), text, timestamp: new Date().toLocaleString('th-TH'), time: Date.now() };
        state.logs.unshift(entry);
        if (state.logs.length > LOG_LIMIT) state.logs.length = LOG_LIMIT;
        enqueue({ op: 'upsert', sheet: 'logs', data: entry });
        mutated();
        renderLogsUI();
    }

    /* ===================== UI HELPERS ===================== */
    function showToast(message, type = 'info') {
        const container = $('toast-container');
        const toast = document.createElement('div');
        const bg = type === 'success' ? 'bg-emerald-600' : type === 'error' ? 'bg-rose-600' : 'bg-blue-600';
        toast.className = `${bg} text-white px-4 py-3 rounded-xl shadow-2xl text-xs font-medium flex items-center justify-between transition-all duration-300 transform translate-y-2 pointer-events-auto`;
        const span = document.createElement('span');
        span.textContent = message;
        const close = document.createElement('i');
        close.className = 'fa-solid fa-xmark ml-3 cursor-pointer';
        close.onclick = () => toast.remove();
        toast.append(span, close);
        container.appendChild(toast);
        setTimeout(() => toast.classList.remove('translate-y-2'), 10);
        setTimeout(() => toast.remove(), type === 'error' ? 5500 : 3500);
    }

    function showCustomDialog(title, message, isConfirm = false) {
        return new Promise((resolve) => {
            const modal = $('dialog-modal');
            $('dialog-title').textContent = title;
            $('dialog-message').textContent = message;
            const btnConfirm = $('dialog-btn-confirm');
            const btnCancel = $('dialog-btn-cancel');
            btnCancel.classList.toggle('hidden', !isConfirm);
            modal.classList.remove('hidden');
            btnConfirm.onclick = () => { modal.classList.add('hidden'); resolve(true); };
            btnCancel.onclick = () => { modal.classList.add('hidden'); resolve(false); };
        });
    }

    function closeModal(id) { $(id).classList.add('hidden'); }

    function populateZoneDropdown(elementId, selected) {
        const select = $(elementId);
        select.innerHTML = Object.keys(defaultZoneNames).map(k => `<option value="${esc(k)}">${esc(zoneLabel(k))}</option>`).join('');
        if (selected) select.value = selected;
    }

    /* ===================== NAVIGATION ===================== */
    function switchTab(tabId) {
        ['layout', 'search', 'list', 'printing', 'logs'].forEach(t => $(`view-${t}`).classList.add('hidden'));
        document.querySelectorAll('.nav-btn').forEach(btn => { btn.classList.remove('text-blue-400'); btn.classList.add('text-slate-400'); });
        $(`view-${tabId}`).classList.remove('hidden');
        const navBtn = $(`nav-${tabId}`);
        if (navBtn) { navBtn.classList.remove('text-slate-400'); navBtn.classList.add('text-blue-400'); }
        if (tabId !== 'search') $('global-search').value = '';
        if (tabId === 'list') renderInventoryTable();
        if (tabId === 'printing') renderPrintingCards();
        if (tabId === 'logs') renderLogsUI();
    }

    /* ===================== RENDERING ===================== */
    function renderAll() {
        updateSvgZoneLabels();
        renderInventoryViews();
        renderPrintingCards();
        renderLogsUI();
    }

    function renderInventoryViews() {
        renderInventoryTable();
        renderZoneItems();
        refreshSearchIfActive();
    }

    function updateSvgZoneLabels() {
        document.querySelectorAll('.zone').forEach(rect => {
            const t = rect.nextElementSibling;
            if (t && t.tagName.toLowerCase() === 'text') t.textContent = zoneLabel(rect.getAttribute('data-zone'));
        });
    }

    function renderInventoryTable() {
        $('total-items-badge').textContent = `${state.inventory.length} รายการ`;
        const tbody = $('inventory-table-body');
        if (!state.inventory.length) {
            tbody.innerHTML = `<tr><td colspan="4" class="px-4 py-10 text-center text-slate-500">ยังไม่มีสินค้าในระบบ — กด "เพิ่มสินค้า" หรือนำเข้า CSV</td></tr>`;
            return;
        }
        const rows = state.inventory.slice(0, TABLE_RENDER_LIMIT).map(item => `
            <tr class="hover:bg-slate-800/50 transition">
                <td class="px-4 py-3 cursor-pointer" data-act="product" data-sku="${esc(item.code)}">
                    <p class="font-bold text-slate-200 text-xs">${esc(item.name)}</p>
                    <p class="text-[10px] text-slate-400 font-mono">${esc(item.code)} (${esc(item.qr)})</p>
                </td>
                <td class="px-4 py-3 font-semibold text-center text-emerald-400 cursor-pointer" data-act="product" data-sku="${esc(item.code)}">${item.qty}</td>
                <td class="px-4 py-3 cursor-pointer" data-act="product" data-sku="${esc(item.code)}">
                    <span class="bg-slate-800 text-slate-300 border border-slate-700 px-2 py-0.5 rounded text-[10px]">${esc(zoneLabel(item.zone))}</span>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                    <button data-act="edit-item" data-id="${esc(item.id)}" class="text-cyan-400 hover:text-cyan-300 p-1.5" title="แก้ไข"><i class="fa-solid fa-pen-to-square"></i></button>
                    <button data-act="delete-item" data-id="${esc(item.id)}" class="text-rose-400 hover:text-rose-300 p-1.5" title="ลบ"><i class="fa-solid fa-trash"></i></button>
                </td>
            </tr>`).join('');
        const more = state.inventory.length > TABLE_RENDER_LIMIT
            ? `<tr><td colspan="4" class="px-4 py-3 text-center text-[11px] text-slate-500">แสดง ${TABLE_RENDER_LIMIT} รายการแรกจาก ${state.inventory.length} — ใช้ช่องค้นหาเพื่อหารายการที่เหลือ</td></tr>` : '';
        tbody.innerHTML = rows + more;
    }

    function renderZoneItems() {
        if ($('zone-modal').classList.contains('hidden') || !currentActiveZone) return;
        const items = state.inventory.filter(i => i.zone === currentActiveZone);
        const list = $('zone-items-list');
        if (!items.length) {
            list.innerHTML = `<div class="text-center text-slate-500 py-12"><i class="fa-solid fa-box-open text-3xl mb-2 block"></i>ไม่มีสินค้าในโซนนี้</div>`;
            return;
        }
        list.innerHTML = items.map(item => `
            <div class="glass-panel border border-slate-800 rounded-xl p-3 hover:border-blue-500/50 cursor-pointer transition press" data-act="product" data-sku="${esc(item.code)}">
                <div class="flex justify-between items-start">
                    <div>
                        <h4 class="font-bold text-slate-100 text-xs">${esc(item.name)}</h4>
                        <p class="text-[11px] text-slate-400 font-mono mt-0.5">SKU: ${esc(item.code)} | QR: ${esc(item.qr)}</p>
                    </div>
                    <span class="bg-blue-500/20 text-blue-400 border border-blue-500/30 text-[11px] px-2 py-0.5 rounded font-bold">${item.qty} ลัง</span>
                </div>
                <div class="text-[10px] text-slate-500 mt-2 flex justify-between">
                    <span>Inbound: ${esc(item.date || '-')} · นับล่าสุด: ${esc(item.countDate || '-')}</span>
                    <span class="text-cyan-400">ดูตำแหน่งทั้งหมด <i class="fa-solid fa-chevron-right text-[9px]"></i></span>
                </div>
            </div>`).join('');
    }

    function runSearch(raw) {
        const keyword = String(raw || '').toLowerCase().trim();
        if (!keyword) { switchTab('layout'); return; }
        if ($('view-search').classList.contains('hidden')) switchTab('search');

        const results = state.inventory.filter(item =>
            item.name.toLowerCase().includes(keyword) ||
            item.code.toLowerCase().includes(keyword) ||
            item.qr.toLowerCase().includes(keyword) ||
            zoneLabel(item.zone).toLowerCase().includes(keyword));

        $('search-count-badge').textContent = `${results.length} รายการ`;
        const container = $('search-results-container');
        if (!results.length) {
            container.innerHTML = `<p class="text-center text-slate-500 py-10 text-xs">ไม่พบสินค้าที่ตรงกับการค้นหา "${esc(keyword)}"</p>`;
            return;
